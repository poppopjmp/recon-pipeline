[[source]]
name = "pypi"
url = "https://pypi.org/simple"
verify_ssl = true

# NOTE: pyproject.toml is the authoritative dependency definition.  This Pipfile
# is kept in sync for users who prefer pipenv; it mirrors the same constraints.

[dev-packages]
pytest = ">=7.0"
coverage = ">=7.0"
black = ">=24.0"
flake8 = ">=6.0"
pre-commit = ">=3.0"
sphinx = ">=7.0"
sphinx-argparse = ">=0.4"
sphinx-rtd-theme = ">=2.0"

[packages]
cmd2 = ">=2.4,<3"
luigi = ">=3.4"
sqlalchemy = ">=1.4,<2.0"
python-libnmap = ">=0.7.3"
pyyaml = ">=6.0"

[requires]
python_version = "3"
